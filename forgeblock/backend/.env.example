# Copy to backend/.env and edit. Never commit the real .env.

# SQLite (default, nothing to set up):
# DATABASE_URL=sqlite:///./forgeblock.db
# Supabase database: Connect > Session pooler (URI)
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# First administrator, created on first start if no admin exists
ADMIN_EMAIL=admin@forgeblock.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=System Administrator

# Research team members who may hold the admin role (Chapter 3, Section 3.8).
# Comma-separated. ADMIN_EMAIL is always allowed.
RESEARCH_TEAM_EMAILS=admin@forgeblock.local

# true during the ForgeBlock study: research-use terms, research labels and
# evaluation-account tools. false for normal use.
STUDY_MODE=false

# Microsoft / Google sign-in through Clerk (clerk.com, free). Leave empty to
# show only email + password. Clerk dashboard > Configure > API keys.
# The secret key stays in this file only; never put it in the frontend or Git.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
OAUTH_PROVIDERS=google,microsoft

# true shows the ledger "Simulate tampering" button to admins (for the defense demo)
DEMO_MODE=true

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# DEVELOPMENT ONLY. true accepts a pen without tilt (e.g. Wacom One CTL-472)
# for the dynamic module, which was trained with Apple Pencil-style pen angles.
# Results are less accurate and marked "Development device". Keep false for
# the study's data gathering and evaluation.
DEV_PEN_DEVICES=false

# Genuine samples needed before personal (adaptive) thresholds are used
MIN_ADAPTIVE_SAMPLES=5

# Confidence score below which a screening is shown as Inconclusive (0-100).
# Set by the research team from the evaluation's error-reject table
# (training/evaluate_static.py prints a suggestion). Not shown in the app.
INCONCLUSIVE_BELOW=20
